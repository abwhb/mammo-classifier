# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
.uv/
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Node
node_modules/
.next/
out/
.turbo/
.vercel/

# Data & models (heavy, downloaded out-of-band)
ml/data/
models/*.pt
models/*.pth
models/*.bin
models/*.onnx
!models/.gitkeep

# Reports artifacts: keep generated JSON + ROC plot in-repo so they show up
# in the PDF report and the reviewer doesn't have to retrain to inspect them.
reports/*.pdf
!reports/.gitkeep

# Local-only screenshots from manual verification
ui-*.png
.playwright-mcp/

# Samples (PHI risk — never commit real DICOMs)
samples/*.dcm
samples/*.png
samples/*.jpg
!samples/.gitkeep
!samples/synthetic_*

# Env & secrets
.env
.env.local
.env.*.local
*.pem
*.key

# OS / editor
.DS_Store
.vscode/
.idea/
*.swp
